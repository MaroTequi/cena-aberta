GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_MODE=log
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=

# true restricts new registrations; an empty list blocks all new accounts.
INVITE_ONLY=false
INVITED_EMAILS=
